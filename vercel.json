{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/registro_psicologos.html",
      "destination": "/registro_psicologos.html"
    },
    {
      "source": "/portal_psicologo.html",
      "destination": "/portal_psicologo.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/ADMIN ENTRENOSOTROS",
      "destination": "/ADMIN ENTRENOSOTROS/index.html"
    },
    {
      "source": "/ADMIN ENTRENOSOTROS/",
      "destination": "/ADMIN ENTRENOSOTROS/index.html"
    },
    {
      "source": "/ADMIN ENTRENOSOTROS/(.*)",
      "destination": "/ADMIN ENTRENOSOTROS/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
